# Copy to .env.local for local work. Never commit real values.
# On Vercel these go in Project Settings > Environment Variables.

# Server only (api/ functions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
DEMO_OTP=123456

# Real SMS OTP (leave empty to stay in demo mode with the fixed DEMO_OTP). Needs supabase/migrations/002_otp.sql.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Needed only for native builds; the web build calls /api on the same site
EXPO_PUBLIC_API_URL=
